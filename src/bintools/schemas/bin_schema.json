{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "contigs": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$",
          "description": "List of contig IDs."
        }
      },
      "fields": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "required": ["name", "contigs", "fields"],
    "additionalProperties": false
  }
}
