{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "sample_id": {
        "type": "string",
        "description": "Name of the sample used to produce the assembly."
      },
      "id": {
        "type": "string",
        "description": "Name of the contig"
      },
      "header": {
        "type": "string",
        "description": "Full contig header."
      },
      "sequence": {
        "type": "string",
        "description": "DNA sequence of the contig."
      },
      "sequence_hash": {
        "type": "string",
        "pattern": "^[a-f0-9]{32}$",
        "description": "Hash of the DNA sequence"
      },
      "sequence_length": {
        "type": "integer",
        "description": "Length of the DNA sequence"
      },
      "topology": {
        "type": "string",
        "description": "Topology of the contig (linear, circular)",
        "enum": ["linear", "circular"]
      },
      "depth": {
        "type": "integer",
        "description": "Sequencing coverage of the contig in the sample."
      },
      "trnas": {
        "type": "object",
        "items": {
          "type": "string"
        },
        "description": "List of tRNA genes"
      },
      "rrna_5s": {
        "type": "boolean",
        "description": "5S rRNA present"
      },
      "rrna_16s": {
        "type": "boolean",
        "description": "16S rRNA present"
      },
      "rrna_23s": {
        "type": "boolean",
        "description": "23S rRNA present"
      }
    },
    "required": [
      "sample_id",
      "id",
      "name",
      "sequence",
      "sequence_hash",
      "sequence_length"
    ],
    "additionalProperties": false
  }
}
